# Copy to .env (never commit .env), or set these from the dashboard: Controls -> API keys (each has a Test button).
# Paper trading on the real market needs no keys at all: the trade feed is free on-chain data.

# Trades are read from pump.fun's on-chain logs over a Solana websocket (free; sniper.feed.trades: solana).
# Empty = the public RPC (wss://api.mainnet-beta.solana.com), which caps data per IP: after many hours of
# this stream it answers "You have used your data allowance". wss://solana-rpc.publicnode.com is free, keyless
# and worked (2026-10-03). Only use paid endpoints that are flat-rate: per-MB billing (e.g. Helius, 2 credits
# / 0.1 MB) makes this ~10-20 GB/day stream expensive.
# Several endpoints may be listed, comma-separated: the feed watchdog switches to the next one when trades stop
# or go missing (PublicNode and the public RPC are always added at the end as fallbacks).
SOLANA_WS_URL=wss://solana-rpc.publicnode.com

# PumpPortal (pumpportal.fun): only needed with sniper.feed.trades: pumpportal (metered: 0.01 SOL / 10k
# trades, ~3 SOL/day measured). Create a key on pumpportal.fun, fund its linked wallet with >= 0.02 SOL.
PUMPPORTAL_API_KEY=

# AI desk (personas that vote on entries and reply to your notes) - pick one in Desk -> AI desk model.
# Anthropic (console.anthropic.com): Claude Opus / Sonnet / Haiku, billed per call (~2 cents a review on Opus).
ANTHROPIC_API_KEY=
# Only for a user key (sk-ant-usr-...): the workspace to bill (wrkspc_...).
ANTHROPIC_WORKSPACE_ID=
# Cheaper or free OpenAI-compatible options (a local Ollama / LM Studio server needs no key):
GITHUB_MODELS_TOKEN=
HF_TOKEN=
OPENROUTER_API_KEY=

# Live trading only - leave empty until docs/SETUP.md step 5. Examples:
#   SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY
#   SOLANA_KEYPAIR_PATH=/Users/you/.config/solana/meme-bot.json     (Mac)
#   SOLANA_KEYPAIR_PATH=/home/you/.config/solana/meme-bot.json      (Ubuntu)
SOLANA_RPC_URL=
SOLANA_KEYPAIR_PATH=
# MEME_TRADER_CONFIRM_LIVE=yes

# DexScreener momentum bot (python -m meme_trader): Jupiter quotes for realistic paper fills and the
# sell-back (honeypot) check; required for its live mode. portal.jup.ag
JUPITER_API_KEY=

# Optional: Helius key for wallet-funding lookups with exchange labels. Saving it from the dashboard also sets
# SOLANA_RPC_URL to https://mainnet.helius-rpc.com/?api-key=... if that's empty.
HELIUS_API_KEY=

# Optional: phone alerts. Bot token from @BotFather; your chat id from @userinfobot.
# TELEGRAM_CHANNEL_ID is only for posting callout cards (sniper.callouts.auto_post: telegram).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
TELEGRAM_CHANNEL_ID=

# Optional: post to X from the dashboard (your own developer app; ~$0.015 a post, $0.20 with a link).
# OAuth 1.0a keys (app permissions: Read and write) - or connect with OAuth 2 in Controls -> Connections.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=

# Optional social signals (contract addresses posted in Telegram channels / by X accounts you choose)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
X_BEARER_TOKEN=
