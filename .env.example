# Copy to .env (never commit .env). Demo needs no keys; the real market needs PUMPPORTAL_API_KEY.

# Trades are read from pump.fun's on-chain logs over a Solana websocket (free; sniper.feed.trades: solana).
# Empty = the public RPC (wss://api.mainnet-beta.solana.com). Only point this at a flat-rate endpoint:
# per-MB billing (e.g. Helius, 2 credits / 0.1 MB) makes this ~20 GB/day stream expensive.
SOLANA_WS_URL=

# PumpPortal (pumpportal.fun): only needed with sniper.feed.trades: pumpportal (metered: 0.01 SOL / 10k
# trades, ~3 SOL/day measured). Create a key on pumpportal.fun, fund its linked wallet with >= 0.02 SOL.
PUMPPORTAL_API_KEY=

# Anthropic API key (console.anthropic.com): AI trading desk + review agent.
ANTHROPIC_API_KEY=

# Live trading only - leave empty until docs/SETUP.md step 5. Examples:
#   SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY
#   SOLANA_KEYPAIR_PATH=/Users/you/.config/solana/meme-bot.json     (Mac)
#   SOLANA_KEYPAIR_PATH=/home/you/.config/solana/meme-bot.json      (Ubuntu)
SOLANA_RPC_URL=
SOLANA_KEYPAIR_PATH=
# MEME_TRADER_CONFIRM_LIVE=yes

# DexScreener momentum bot (python -m meme_trader): Jupiter quotes for realistic paper fills and the
# sell-back (honeypot) check; required for its live mode. portal.jup.ag
JUPITER_API_KEY=

# Optional: Helius key for wallet-funding lookups with exchange labels (paid plan; else SOLANA_RPC_URL is used)
HELIUS_API_KEY=

# Optional: phone alerts. Bot token from @BotFather; your chat id from @userinfobot.
# TELEGRAM_CHANNEL_ID is only for posting callout cards (sniper.callouts.auto_post: telegram).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
TELEGRAM_CHANNEL_ID=

# Optional social signals
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
X_BEARER_TOKEN=
