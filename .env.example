# Copy to .env (never commit .env). Demo needs no keys; the real market needs PUMPPORTAL_API_KEY.

# PumpPortal (pumpportal.fun): needed for per-token trade streams on live data + copy trading.
# Create a key on pumpportal.fun, fund its linked wallet with >= 0.02 SOL.
PUMPPORTAL_API_KEY=

# Anthropic API key (console.anthropic.com): AI trading desk + review agent.
ANTHROPIC_API_KEY=

# Live trading only - leave empty until docs/SETUP.md step 5. Examples:
#   SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY
#   SOLANA_KEYPAIR_PATH=/Users/you/.config/solana/meme-bot.json     (Mac)
#   SOLANA_KEYPAIR_PATH=/home/you/.config/solana/meme-bot.json      (Ubuntu)
SOLANA_RPC_URL=
SOLANA_KEYPAIR_PATH=
# MEME_TRADER_CONFIRM_LIVE=yes

# Optional: Helius key for wallet-funding lookups with exchange labels (paid plan; else SOLANA_RPC_URL is used)
HELIUS_API_KEY=

# Optional: phone alerts. Bot token from @BotFather; your chat id from @userinfobot.
# TELEGRAM_CHANNEL_ID is only for posting callout cards (sniper.callouts.auto_post: telegram).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
TELEGRAM_CHANNEL_ID=

# Optional social signals
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
X_BEARER_TOKEN=
